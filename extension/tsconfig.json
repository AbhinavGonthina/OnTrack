{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mts",
    ".wxt/**/*"
  ]
}
