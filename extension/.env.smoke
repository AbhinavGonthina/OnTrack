# Loaded by WXT (Vite) for `wxt build --mode smoke`, which the live smoke test
# loads from .output/chrome-mv3-smoke.
#
# This file exists because mode "smoke" is not "development", so .env.development
# does not apply and the build would otherwise fall back to the production
# defaults in src/config.ts and probe the real API. The smoke test opens real
# third-party job pages, but it must still talk to the local backend only.
WXT_API_URL=http://localhost:8080
WXT_APP_URL=http://localhost:3000
