# Copy this file to `.env` (gitignored) and fill in real values.
# Neon gives you a combined connection string like:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Split it into the three vars below — Spring needs the JDBC URL and
# credentials separate, not combined. Neon's dashboard also has a
# "Parameters only" view that shows Host/Database/User/Password individually
# if that's easier than splitting the combined string by hand.

DATABASE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
DATABASE_USERNAME=your_neon_username
DATABASE_PASSWORD=your_neon_password

JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key
RESEND_API_KEY=your_resend_api_key

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Where "report a problem" feedback gets emailed - never exposed to the frontend.
FEEDBACK_RECIPIENT_EMAIL=your_email@example.com
